# Ключ приложения Telegram: https://my.telegram.org, раздел API development tools.
# Скопируйте этот файл в .env и заполните. .env в репозиторий не попадает.
TG_API_ID=
TG_API_HASH=

# Файл сессии. Заводится один раз командой `node bin/login.mjs`, дальше только читается.
# Путь относительный — считается от каталога, из которого запущен процесс.
TG_SESSION=tg.session

# База заявок. Коллектор пишет сюда, раздел харнесса читает тот же файл — путь должен
# совпадать с dbPath профиля, иначе раздел покажет пустой Inbox при работающем сборе.
INBOX_DB=inbox.db

# Чаты, за которыми следим: username, ссылка или идентификатор, через запятую.
# `me` — «Избранное», удобно для проверки: пишете себе с телефона и видите заявку.
WATCHED_CHATS=me

# Бюджет задержки в секундах. Заявка, собранная позже него, помечается пришедшей
# с задержкой: догонять простой машины раздел не обязан, скрывать его — обязан не.
DELAY_BUDGET_SEC=300
