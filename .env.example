# Ключ приложения Telegram: https://my.telegram.org, раздел API development tools.
# Скопируйте этот файл в .env и заполните. .env в репозиторий не попадает.
TG_API_ID=
TG_API_HASH=

# Файл сессии. Заводится один раз командой `node bin/login.mjs`, дальше только читается.
# Путь относительный — считается от каталога, из которого запущен процесс.
TG_SESSION=tg.session

# База заявок для командной строки. Раздел харнесса берёт свой путь из конфигурации
# профиля (dbPath относительно workspaceRoot), а не отсюда.
INBOX_DB=inbox.db
